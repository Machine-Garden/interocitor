{
  "name": "@interocitor/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-public": "node scripts/prepare-public.mjs",
    "dev": "yarn prepare-public && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "yarn prepare-public && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "check": "tsc --noEmit",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

{
  "name": "todo-cloudflare-do-example",
  "private": true,
  "version": "0.0.0",
  "description": "Cloudflare Worker + Durable Object WebDAV emulation for Interocitor TODO demo",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'wrangler dev --port ${PORT:-8787} --persist-to .wrangler/state'",
    "deploy": "wrangler deploy",
    "check": "node --check ../../packages/interocitor-workers/src/index.js",
    "db:migrate:local": "wrangler d1 migrations apply TODO_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply TODO_DB --remote"
  },
  "devDependencies": {
    "wrangler": "^4.10.0"
  }
}

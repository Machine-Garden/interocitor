{
  "name": "todo-cloudflare-do-example",
  "private": true,
  "version": "0.0.0",
  "description": "Cloudflare Worker + D1 Interocitor TODO demo mounted under an app-owned prefix",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'wrangler dev --port ${PORT:-8787} --persist-to .wrangler/state'",
    "deploy": "wrangler deploy",
    "check": "node --check ./todo-interocitor.js",
    "db:migrate:local": "wrangler d1 migrations apply INTEROCITOR_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply INTEROCITOR_DB --remote"
  },
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.10.0"
  }
}

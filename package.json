{
  "name": "interocitor-monorepo",
  "private": true,
  "version": "0.0.0-beta.2",
  "packageManager": "yarn@4.6.0",
  "description": "Umbrella monorepo for Interocitor packages, runtimes, examples, and future platform ports.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:int": "yarn workspace @interocitor/core build",
    "build:all": "yarn build:int && yarn workspaces foreach --all --exclude @interocitor/core -p run build",
    "validate": "yarn build:all",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "demo:todo": "yarn workspace @interocitor/core build && yarn demo:todo:server",
    "demo:todo:server": "yarn workspace todo-webdav-example server:file",
    "test:e2e": "yarn workspace @interocitor/core test:e2e",
    "test:e2e:todo": "yarn workspace @interocitor/core test:e2e:todo",
    "test:e2e:cloudflare": "yarn workspace @interocitor/core build && playwright test -c examples/todo-cloudflare-do/playwright.config.ts",
    "test:e2e:cloudflare:run": "yarn workspace @interocitor/core build && RUN_CF_EXAMPLE_TESTS=1 playwright test -c examples/todo-cloudflare-do/playwright.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "keywords": [
    "local-first",
    "crdt",
    "sync",
    "offline-first",
    "google-drive",
    "webdav",
    "encrypted",
    "mesh",
    "indexeddb",
    "monorepo"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

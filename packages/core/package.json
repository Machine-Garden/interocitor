{
  "name": "@interocitor/core",
  "version": "0.2.0",
  "description": "Local-first CRDT rows and durable remote files with optional client-side encryption.",
  "keywords": [
    "crdt",
    "encrypted",
    "google-drive",
    "local-first",
    "mesh",
    "offline-first",
    "s3",
    "sync",
    "webdav"
  ],
  "homepage": "https://github.com/Machine-Garden/interocitor/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Machine-Garden/interocitor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Machine-Garden/interocitor.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory.d.ts",
      "import": "./dist/adapters/memory.js"
    },
    "./adapters/google-drive": {
      "types": "./dist/adapters/google-drive.d.ts",
      "import": "./dist/adapters/google-drive.js"
    },
    "./adapters/webdav": {
      "types": "./dist/adapters/webdav.d.ts",
      "import": "./dist/adapters/webdav.js"
    },
    "./adapters/cloudflare": {
      "types": "./dist/adapters/cloudflare.d.ts",
      "import": "./dist/adapters/cloudflare.js"
    },
    "./adapters/s3": {
      "types": "./dist/adapters/s3.d.ts",
      "import": "./dist/adapters/s3.js"
    },
    "./storage/local-store": {
      "types": "./dist/storage/local-store.d.ts",
      "import": "./dist/storage/local-store.js"
    },
    "./handshake/qr": {
      "types": "./dist/handshake/qr-public.d.ts",
      "import": "./dist/handshake/qr-public.js"
    },
    "./crypto/keys": {
      "types": "./dist/crypto/keys.d.ts",
      "import": "./dist/crypto/keys.js"
    },
    "./crypto/recovery": {
      "types": "./dist/crypto/recovery.d.ts",
      "import": "./dist/crypto/recovery.js"
    },
    "./crypto/signing": {
      "types": "./dist/crypto/signing.d.ts",
      "import": "./dist/crypto/signing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.json",
    "validate": "node ./dist/index.js",
    "test:unit": "yarn build && node --test tests/*.test.mjs",
    "test:e2e": "yarn build && ../../node_modules/.bin/playwright test -c ./playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

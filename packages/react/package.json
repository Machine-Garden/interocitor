{
  "name": "@interocitor/react",
  "version": "0.1.0",
  "description": "React bindings for Interocitor live queries, rows, images, connected stores, and connection status.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheUiTeam/interocitor.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/TheUiTeam/interocitor/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/TheUiTeam/interocitor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf ./dist && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@interocitor/core": "0.1.0",
    "@interocitor/web": "0.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@interocitor/core": "workspace:*",
    "@interocitor/web": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "react": "^19.0.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "^6.0.0"
  },
  "keywords": [
    "interocitor",
    "react",
    "local-first",
    "crdt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}

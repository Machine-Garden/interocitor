{
  "name": "@interocitor/workers",
  "version": "0.0.0-beta.8",
  "description": "Cloudflare Workers runtime for Interocitor-native sync endpoints, semantic storage ops, relay wiring, and maintenance flows.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "schema.sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "interocitor",
    "cloudflare-workers",
    "durable-objects",
    "d1"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }

{
  "name": "@interocitor/workers",
  "version": "0.1.0",
  "description": "Cloudflare Workers runtime for Interocitor sync with D1 plus R2 or regional AWS S3 durable-file storage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheUiTeam/interocitor.git",
    "directory": "packages/workers"
  },
  "homepage": "https://github.com/TheUiTeam/interocitor/tree/main/packages/workers#readme",
  "bugs": {
    "url": "https://github.com/TheUiTeam/interocitor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "src",
    "README.md",
    "LICENSE",
    "schema.sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "yarn build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "interocitor",
    "cloudflare-workers",
    "aws-s3",
    "durable-objects",
    "d1"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
